# Quorum Production Configuration Example
# Copy this file to .env.production and fill in your values:
# cp .env.production.example .env.production

# Strong password for FalkorDB (required)
FALKORDB_PASSWORD=change-me-to-a-strong-password

# Initial production tokens generated by: python scripts/make_token.py --tenant acme --role human --name ops
# Format: {"<token>": {"tenant": "<tenant>", "role": "human|agent|auditor", "agent_id": "<name>"}}
QUORUM_TOKENS_JSON={"token_secret_here":{"tenant":"acme","role":"human","agent_id":"ops"}}

# Public URL where agents and users reach the hub (e.g. https://quorum.example.com:8443)
QUORUM_PUBLIC_URL=https://localhost:8443

# Allowed browser origins for CORS (e.g. https://quorum.example.com:8443)
QUORUM_CORS_ORIGINS=https://localhost:8443

# Trusted reverse proxies (e.g. Docker private network subnets for Caddy proxy)
QUORUM_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Member token expiration in days (0 means tokens do not expire)
QUORUM_MEMBER_TOKEN_TTL_DAYS=90
